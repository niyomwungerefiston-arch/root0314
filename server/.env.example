# ================================================================
# Buchat — variables d'environnement serveur
# ================================================================
# Copiez ce fichier vers server/.env et adaptez les valeurs.

# ---- Port HTTP ----
PORT=3000

# ---- JWT ----
# CHANGEZ CETTE CLE EN PRODUCTION
JWT_SECRET=buchat-secret-change-in-production

# ---- PostgreSQL ----
DATABASE_URL=postgres://buchat:buchat@localhost:5432/buchat
PG_POOL_MAX=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (stockage medias) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=buchat
MINIO_SECRET_KEY=buchat-secret-change-me
MINIO_PUBLIC_URL=http://localhost:9000

# ---- Web Push VAPID ----
# Generez ces cles une seule fois avec : npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@bujaonline.com

# ---- TURN / STUN (WebRTC) ----
TURN_SERVER=turn:localhost:3478
TURN_USERNAME=buchat
TURN_PASSWORD=buchat-turn-secret

# ---- Mode d'inscription ----
# true  = mode ferme : code d'invitation obligatoire (sauf 1er user)
# false = mode ouvert : inscription libre
BUCHAT_INVITE_ONLY=false

# ---- URL publique (pour generer les liens d'invitation) ----
BUCHAT_PUBLIC_URL=https://buchat.bujaonline.com

# ---- bcrypt ----
BCRYPT_ROUNDS=10
