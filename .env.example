# ================================================================
# Buchat — docker-compose environment
# ================================================================
# Copiez en .env puis adaptez.

# ---- PostgreSQL ----
POSTGRES_USER=buchat
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=buchat

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-string

# ---- MinIO ----
MINIO_ACCESS_KEY=buchat
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_PUBLIC_URL=https://buchat.bujaonline.com/media

# ---- Web Push VAPID ----
# Generez une fois : cd server && npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@bujaonline.com

# ---- TURN ----
TURN_SERVER=turn:buchat.bujaonline.com:3478
TURN_USERNAME=buchat
TURN_PASSWORD=change-this-turn-password

# ---- Mode ----
BUCHAT_INVITE_ONLY=false
BUCHAT_PUBLIC_URL=https://buchat.bujaonline.com
